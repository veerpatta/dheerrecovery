# Neon pooled connection string.
# Neon dashboard -> your project -> Connect -> "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------------- alerts ---
# Web push. Generate the pair once with:
#     npx web-push generate-vapid-keys
#
# Never rotate these on a live record: the keys are half of every existing
# subscription, so a new pair silently stops every phone receiving anything
# and each one has to be turned on again by hand.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# The same value as VAPID_PUBLIC_KEY. The browser needs it to subscribe, so it
# has to reach the client bundle — it is a public key and safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Contact address a push service can use if something is wrong with our sends.
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for /api/cron/tick, which is what the external scheduler calls.
# Any 32+ random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The route refuses everything with a 503 while this is unset, so a deploy that
# forgets it is closed rather than open.
CRON_SECRET=""
